<resources>
    <style name="Theme.StickerSync" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">#64E3C0</item>
        <item name="colorPrimaryVariant">#3EBB98</item>
        <item name="colorOnPrimary">#101923</item>
        <item name="colorSecondary">#64E3C0</item>
        <item name="colorOnSecondary">#101923</item>
        <item name="colorSurface">#1B2633</item>
        <item name="colorOnSurface">#F3F6FA</item>
        <item name="colorError">#FF9DA4</item>
        <item name="colorOnError">#101923</item>
        <item name="android:colorBackground">#101923</item>
        <item name="android:windowBackground">#101923</item>
        <item name="android:textColorPrimary">#F3F6FA</item>
        <item name="android:textColorSecondary">#A8B5C5</item>
        <item name="android:statusBarColor">#101923</item>
        <item name="android:navigationBarColor">#101923</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowAnimationStyle">@style/StickerSync.WindowMotion</item>
    </style>
    <style name="StickerSync.WindowMotion" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/screen_enter</item>
        <item name="android:activityOpenExitAnimation">@anim/screen_exit</item>
        <item name="android:activityCloseEnterAnimation">@anim/screen_enter</item>
        <item name="android:activityCloseExitAnimation">@anim/screen_exit</item>
    </style>
</resources>

